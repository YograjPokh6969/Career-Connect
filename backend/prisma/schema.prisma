generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model application_status_history {
  history_id     BigInt              @id @default(autoincrement())
  application_id BigInt
  old_status     application_status?
  new_status     application_status
  changed_by     BigInt?
  note           String?
  changed_at     DateTime            @default(now()) @db.Timestamptz(6)
  applications   applications        @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  users          users?              @relation(fields: [changed_by], references: [user_id], onUpdate: NoAction)
}

model applications {
  application_id             BigInt                       @id @default(autoincrement())
  job_id                     BigInt
  student_id                 BigInt
  resume_id                  BigInt?
  cover_letter               String?
  status                     application_status           @default(applied)
  applied_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  status_changed_at          DateTime                     @default(now()) @db.Timestamptz(6)
  reviewed_by                BigInt?
  review_notes               String?
  application_status_history application_status_history[]
  job_postings               job_postings                 @relation(fields: [job_id], references: [job_id], onUpdate: NoAction)
  resumes                    resumes?                     @relation(fields: [resume_id], references: [resume_id], onUpdate: NoAction)
  users                      users?                       @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)
  student_profiles           student_profiles             @relation(fields: [student_id], references: [student_id], onUpdate: NoAction)
  interviews                 interviews[]
  notifications              notifications[]
  placement_records          placement_records?

  @@unique([job_id, student_id], map: "uq_application_job_student")
  @@index([job_id, status, applied_at(sort: Desc)], map: "idx_applications_job")
  @@index([student_id, status, applied_at(sort: Desc)], map: "idx_applications_student")
}

model company_profiles {
  company_id                                BigInt                      @id
  legal_name                                String                      @db.VarChar(200)
  website                                   String?
  industry                                  String?                     @db.VarChar(120)
  description                               String?
  office_address                            String?
  verification_status                       company_verification_status @default(pending)
  verified_by                               BigInt?
  verified_at                               DateTime?                   @db.Timestamptz(6)
  created_at                                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime                    @default(now()) @db.Timestamptz(6)
  users_company_profiles_company_idTousers  users                       @relation("company_profiles_company_idTousers", fields: [company_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_company_user")
  users_company_profiles_verified_byTousers users?                      @relation("company_profiles_verified_byTousers", fields: [verified_by], references: [user_id], onUpdate: NoAction, map: "fk_company_verified_by")
  job_postings                              job_postings[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model interviews {
  interview_id     BigInt           @id @default(autoincrement())
  application_id   BigInt
  round_number     Int              @default(1) @db.SmallInt
  scheduled_at     DateTime         @db.Timestamptz(6)
  duration_minutes Int              @default(30) @db.SmallInt
  mode             String           @default("online") @db.VarChar(30)
  meeting_location String?
  interviewer_name String?          @db.VarChar(150)
  status           interview_status @default(scheduled)
  feedback         String?
  created_by       BigInt
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  applications     applications     @relation(fields: [application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  users            users            @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)

  @@unique([application_id, round_number], map: "uq_interview_round")
  @@index([scheduled_at], map: "idx_interviews_schedule", where: raw("(status = 'scheduled'::interview_status)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model job_postings {
  job_id               BigInt                @id @default(autoincrement())
  company_id           BigInt
  title                String                @db.VarChar(200)
  description          String
  job_type             String                @default("full_time") @db.VarChar(50)
  location             String?               @db.VarChar(150)
  salary_min           Decimal?              @db.Decimal(12, 2)
  salary_max           Decimal?              @db.Decimal(12, 2)
  openings             Int                   @default(1)
  min_cgpa             Decimal?              @db.Decimal(3, 2)
  eligible_department  String?               @db.VarChar(120)
  eligible_degree      String?               @db.VarChar(120)
  graduation_year_from Int?                  @db.SmallInt
  graduation_year_to   Int?                  @db.SmallInt
  application_deadline DateTime              @db.Timestamptz(6)
  status               job_status            @default(draft)
  posted_at            DateTime?             @db.Timestamptz(6)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime              @default(now()) @db.Timestamptz(6)
  applications         applications[]
  company_profiles     company_profiles      @relation(fields: [company_id], references: [company_id], onUpdate: NoAction)
  job_required_skills  job_required_skills[]
  notifications        notifications[]

  @@index([status, application_deadline, company_id], map: "idx_jobs_search")
}

model job_required_skills {
  job_id       BigInt
  skill_id     BigInt
  is_mandatory Boolean      @default(true)
  job_postings job_postings @relation(fields: [job_id], references: [job_id], onDelete: Cascade, onUpdate: NoAction)
  skills       skills       @relation(fields: [skill_id], references: [skill_id], onUpdate: NoAction)

  @@id([job_id, skill_id])
}

model notifications {
  notification_id        BigInt            @id @default(autoincrement())
  user_id                BigInt
  notification_type      notification_type
  title                  String            @db.VarChar(200)
  message                String
  related_job_id         BigInt?
  related_application_id BigInt?
  is_read                Boolean           @default(false)
  read_at                DateTime?         @db.Timestamptz(6)
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  applications           applications?     @relation(fields: [related_application_id], references: [application_id], onDelete: Cascade, onUpdate: NoAction)
  job_postings           job_postings?     @relation(fields: [related_job_id], references: [job_id], onDelete: Cascade, onUpdate: NoAction)
  users                  users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_unread", where: raw("(is_read = false)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model placement_records {
  placement_id         BigInt       @id @default(autoincrement())
  application_id       BigInt       @unique
  placement_officer_id BigInt?
  offered_salary       Decimal?     @db.Decimal(12, 2)
  offer_date           DateTime     @db.Date
  joining_date         DateTime?    @db.Date
  offer_accepted       Boolean?
  remarks              String?
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @db.Timestamptz(6)
  applications         applications @relation(fields: [application_id], references: [application_id], onUpdate: NoAction)
  users                users?       @relation(fields: [placement_officer_id], references: [user_id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resumes {
  resume_id        BigInt           @id @default(autoincrement())
  student_id       BigInt           @unique(map: "uq_primary_resume_per_student", where: raw("(is_primary = true)"))
  file_name        String           @db.VarChar(255)
  storage_key      String           @unique
  mime_type        String           @db.VarChar(100)
  file_size_bytes  Int
  is_primary       Boolean          @default(false)
  uploaded_at      DateTime         @default(now()) @db.Timestamptz(6)
  applications     applications[]
  student_profiles student_profiles @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_resume_student")
}

model skills {
  skill_id            BigInt                @id @default(autoincrement())
  skill_name          String                @unique @db.VarChar(100)
  job_required_skills job_required_skills[]
  student_skills      student_skills[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_profiles {
  student_id         BigInt           @id
  university_roll_no String           @unique @db.VarChar(50)
  department         String           @db.VarChar(120)
  degree             String           @db.VarChar(120)
  graduation_year    Int              @db.SmallInt
  cgpa               Decimal?         @db.Decimal(3, 2)
  date_of_birth      DateTime?        @db.Date
  linkedin_url       String?
  github_url         String?
  address            String?
  profile_completed  Boolean          @default(false)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  applications       applications[]
  resumes            resumes?
  users              users            @relation(fields: [student_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_user")
  student_skills     student_skills[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_skills {
  student_id       BigInt
  skill_id         BigInt
  proficiency      Int?             @db.SmallInt
  skills           skills           @relation(fields: [skill_id], references: [skill_id], onUpdate: NoAction)
  student_profiles student_profiles @relation(fields: [student_id], references: [student_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([student_id, skill_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id                                              BigInt                       @id @default(autoincrement())
  email                                                String                       @unique @db.VarChar(254)
  password_hash                                        String
  role                                                 user_role
  full_name                                            String                       @db.VarChar(150)
  phone                                                String?                      @db.VarChar(30)
  is_active                                            Boolean                      @default(true)
  last_login_at                                        DateTime?                    @db.Timestamptz(6)
  created_at                                           DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                           DateTime                     @default(now()) @db.Timestamptz(6)
  application_status_history                           application_status_history[]
  applications                                         applications[]
  company_profiles_company_profiles_company_idTousers  company_profiles?            @relation("company_profiles_company_idTousers")
  company_profiles_company_profiles_verified_byTousers company_profiles[]           @relation("company_profiles_verified_byTousers")
  interviews                                           interviews[]
  notifications                                        notifications[]
  placement_records                                    placement_records[]
  student_profiles                                     student_profiles?
}

enum application_status {
  applied
  under_review
  shortlisted
  rejected
  withdrawn
  selected
}

enum company_verification_status {
  pending
  verified
  rejected
  suspended
}

enum interview_status {
  scheduled
  completed
  cancelled
  no_show
}

enum job_status {
  draft
  open
  closed
  cancelled
}

enum notification_type {
  job_opened
  application_status
  interview_scheduled
  interview_updated
  placement_update
  system
}

enum user_role {
  student
  company
  placement_officer
}
